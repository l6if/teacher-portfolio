{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && prisma migrate deploy && node scripts/prod-remove-qa-shells.mjs; next build",
  "functions": {
    "src/app/api/files/[id]/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/upload/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/report/route.ts": {
      "maxDuration": 60
    }
  }
}