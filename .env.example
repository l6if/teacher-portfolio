# ═══ نموذج متغيرات البيئة — ملف إنجاز المعلم الإلكتروني ═══════════════════
# انسخه إلى .env واملأ القيم. لا تضع أي مفتاح خدمة (SERVICE_ROLE) في أي
# متغير يبدأ بـ NEXT_PUBLIC_ — هذه تدخل حزمة المتصفح العامة!

# ─── قاعدة البيانات (PostgreSQL حصريًا) ─────────────────────────────
# التطوير (محلي): PostgreSQL على 5433
# DATABASE_URL="postgresql://postgres@127.0.0.1:5433/teacherfolio"
# DIRECT_URL="postgresql://postgres@127.0.0.1:5433/teacherfolio"
#
# الإنتاج (Supabase) — من Project Settings → Database → Connection string:
#   DATABASE_URL = التجميعي (pgbouncer، منفذ 6543) — لاستعلامات التطبيق
#   DIRECT_URL   = المباشر (منفذ 5432) — للمهاجرات (migrate deploy)
# مثال:
# DATABASE_URL="postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_URL=""
DIRECT_URL=""

# ─── أمان الجلسة ───────────────────────────────────────────────────
# سر توقيع توكن HMAC — 32 حرفًا على الأقل، مطلوب في الإنتاج
# توليد: openssl rand -hex 32
SESSION_SECRET=""

# ─── Supabase Storage (الإنتاج) — حاوية خاصة فقط ───────────────────
# من Project Settings → API:
#   SUPABASE_URL             = https://<ref>.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY = مفتاح الخدمة — ⚠️ جانب الخادم حصرًا،
#                               لا يجوز استخدامه في أي متغير NEXT_PUBLIC_
#                               ولا في أي كود عميل إطلاقًا
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# اسم الحاوية (يجب إنشاؤها خاصة: Private bucket — لا Public)
SUPABASE_STORAGE_BUCKET="teacher-evidence"

# ─── متغيرات العميل العامة (آمنة للنشر — anon فقط) ─────────────────
# يستخدمها مسار الرفع الموقّع للملفات الكبيرة (رفع مباشر بروابط موقعة
# قصيرة العمر) — مفتاح anon العام بالتصميم، لا يمنح أي وصول للقراءة:
# الصلاحيات تُدار في /api/files من الخادم.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_STORAGE_BUCKET="teacher-evidence"
# حد الرفع عبر الوكيل (MB) — الأكبر منه يذهب لمسار الرفع الموقّع
NEXT_PUBLIC_PROXY_UPLOAD_LIMIT_MB="4"

# ─── اختياري: فرض مزوّد التخزين ─────────────────────────────────────
# STORAGE_DRIVER="local"  → يفرض التخزين المحلي حتى مع ضبط Supabase
#                           (للاختبار فقط — الإنتاج يرفض المحلي قاطعًا
#                            إلا مع STORAGE_ALLOW_LOCAL_IN_PROD=1)
# UPLOAD_DIR="/abs/path"  → جذر التخزين المحلي (الافتراضي storage/uploads)
