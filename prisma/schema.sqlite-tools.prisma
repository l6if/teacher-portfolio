generator client {
  provider = "prisma-client-js"
  output   = "../.sqlite-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── المستخدمون ───────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  passwordHash String?
  name      String
  role      String   @default("TEACHER") // TEACHER | MANAGER | SUPER_ADMIN

  // حالة الحساب — الإيقاف الإداري يمنع الدخول ويُبطل الجلسة القائمة
  status      String    @default("ACTIVE") // ACTIVE | SUSPENDED
  // الجنس — صياغة عربية واعية (null = محايد مؤقتًا حتى يختار المستخدم)
  gender      String? // MALE | FEMALE
  lastLoginAt DateTime?
  // نسخة الجلسة — تُرفع عند تغيير كلمة المرور لإبطال كل التوكنات القديمة
  sessionEpoch Int      @default(0)
  // حساب المعاينة التجريبي (معزول — لا يرى بيانات حقيقية)
  isDemo     Boolean   @default(false)

  // البيانات المهنية
  school          String?
  subject         String?
  qualification   String?
  experienceYears Int?
  stage           String?
  classes         String?
  licenseNumber   String?
  duties          String?
  photoUrl        String?

  // بيانات جهة العمل — ترويسة التقرير الرسمي (كلها اختيارية)
  educationAdmin  String? // الإدارة التعليمية — مثال: إدارة تعليم الرياض
  educationOffice String? // مكتب التعليم — مثال: مكتب تعليم شمال الرياض
  principalName   String? // اسم مدير/ة المدرسة — خانة التوقيع في التقرير الرسمي

  // التكليف والنصاب
  weeklyLoad  Int?
  schedule    String? // JSON [{day, grade, periods}]
  committees  String? // JSON [{name, role}]
  extraDuties String? // JSON [string]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  years       AcademicYear[]
  goals       Goal[]
  achievements Achievement[]
  attachments Attachment[]
  reflections Reflection[]
  devPlans    DevPlan[]
  resetTokens PasswordResetToken[]
  aiLogs      AiUsageLog[]

  @@index([role])
  @@index([status])
  @@index([isDemo])
}

// ─── توكنات استعادة كلمة المرور ─────────────────────────────
// يُخزّن هاش التوكن فقط (sha256) — الخام يُرسل للمستخدم عبر البريد مرة واحدة.
// استخدام واحد + صلاحية محدودة (45 دقيقة افتراضيًا).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── سجل استخدام الذكاء الاصطناعي ────────────────────────────
// سجل خفيف بلا محتوى: لا يُخزّن الـ prompt ولا الـ response — خصوصية أولًا.
model AiUsageLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // suggestObjectives | improveText | proofread | ...
  model      String?
  success    Boolean  @default(true)
  latencyMs  Int?
  promptTokens     Int?
  completionTokens Int?
  errorKind  String? // timeout | rate_limit | provider_error | invalid_output
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

// ─── السنوات الدراسية ─────────────────────────────────────────
model AcademicYear {
  id        String  @id @default(cuid())
  label     String // "1448هـ"
  archived  Boolean @default(false)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  goals        Goal[]
  achievements Achievement[]
  attachments  Attachment[]
  reflections  Reflection[]
  devPlans     DevPlan[]

  @@index([userId])
  @@index([userId, archived])
}

// ─── الأهداف المهنية ──────────────────────────────────────────
model Goal {
  id           String    @id @default(cuid())
  title        String
  description  String?
  indicator    String?
  targetValue  Float?
  currentValue Float?
  startDate    DateTime?
  endDate      DateTime?
  scope        String    @default("YEAR") // YEAR | TERM1 | TERM2
  userId       String
  yearId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  year         AcademicYear  @relation(fields: [yearId], references: [id], onDelete: Cascade)
  achievements Achievement[]
  links        EvidenceLink[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, yearId])
}

// ─── الإطار المهني: المجالات ← المعايير ← المعايير الفرعية ─────
// المرجع الرسمي: المعايير والمسارات المهنية للمعلمين في المملكة
// العربية السعودية — هيئة تقويم التعليم والتدريب (1439هـ، ISBN
// 978-603-90852-1-8): 3 مجالات، 10 معايير، 32 معيارًا فرعيًا.
// العناصر الرسمية (isOfficial=true) عالمية ومحمية النص؛ والمخصصة
// على مستوى المدرسة (scope=SCHOOL + schoolId).
model Domain {
  id           String    @id @default(cuid())
  name         String
  description  String?
  isOfficial   Boolean   @default(false)
  officialCode String?   @unique // D1..D3 للرسمي — null للمخصص
  sortOrder    Int       @default(0)
  scope        String    @default("GLOBAL") // GLOBAL | SCHOOL
  schoolId     String? // المخصص: مدرسة المنشئ — لا يظهر لمدارس أخرى
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  criteria     Criterion[]
  achievements Achievement[]

  @@index([isOfficial, sortOrder])
  @@index([scope, schoolId])
}

model Criterion {
  id           String    @id @default(cuid())
  domainId     String
  name         String
  description  String?
  isOfficial   Boolean   @default(false)
  officialCode String?   @unique // C1..C10 للرسمي — null للمخصص
  sortOrder    Int       @default(0)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  domain        Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  subCriteria   SubCriterion[]
  achievements  Achievement[]

  @@index([domainId, sortOrder])
  @@index([isOfficial])
}

model SubCriterion {
  id           String    @id @default(cuid())
  criterionId  String
  name         String
  description  String?
  isOfficial   Boolean   @default(false)
  officialCode String?   @unique // S1.1..S10.3 — الترقيم الرسمي (معيار.فرعي)
  sortOrder    Int       @default(0)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  criterion    Criterion    @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  achievements Achievement[]

  @@index([criterionId, sortOrder])
  @@index([isOfficial])
}

// ─── الإنجاز / الشاهد المهني (الوحدة الأساسية) ────────────────
model Achievement {
  id            String    @id @default(cuid())
  type          String // PRACTICE | REMEDIAL | ENRICHMENT | PD | INITIATIVE | AWARD | PARTICIPATION | CERTIFICATE | ACTIVITY | ASSESSMENT | PLAN | COOP | OTHER
  title         String
  field         String? // التصنيف القديم — يُحفظ مؤقتًا كـ legacyCategory حتى اكتمال الترحيل
  date          DateTime?
  description   String? // وصف مختصر
  goalText      String? // الهدف من الإنجاز
  execution     String? // ماذا نُفّذ / طريقة التنفيذ
  beneficiaries String? // الفئة المستفيدة
  results       String?
  impact        String?
  notes         String?
  problem       String? // المشكلة / الحاجة
  actions       String? // الإجراءات / مراحل التنفيذ
  durationText  String? // مدة التنفيذ
  provider      String? // الجهة (للتدريب)
  hours         Float? // عدد الساعات
  studentsCount Int? // عدد الطلاب
  beneficiariesCount Int? // عدد المستفيدين
  preScore      Float?
  postScore     Float?
  keywords      String?
  status        String    @default("DRAFT") // DRAFT | COMPLETED | NEEDS_WORK | APPROVED
  goalId        String?
  goal          Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)

  // ─── التصنيف داخل الإطار المهني (مجال ← معيار ← معيار فرعي) ───
  // كلها اختيارية: الإنجازات القديمة غير المصنفة تظهر «يحتاج تصنيفًا»
  // حتى يحدد المستخدم معيارها — لا تخمين ولا فقد بيانات (SetNull عند حذف العنصر المخصص).
  domainId       String?
  criterionId    String?
  subCriterionId String?
  domain        Domain?       @relation(fields: [domainId], references: [id], onDelete: SetNull)
  criterion     Criterion?    @relation(fields: [criterionId], references: [id], onDelete: SetNull)
  subCriterion  SubCriterion? @relation(fields: [subCriterionId], references: [id], onDelete: SetNull)

  userId        String
  yearId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  year          AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  links         EvidenceLink[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId, yearId])
  @@index([yearId, type])
  @@index([goalId])
  @@index([status])
}

// ─── الشواهد والمرفقات ────────────────────────────────────────
model Attachment {
  id        String   @id @default(cuid())
  title     String
  kind      String // IMAGE | PDF | DOC | SHEET | VIDEO | LINK | OTHER
  fileName  String?
  fileSize  Int?
  mimeType  String?
  url       String?
  keywords  String?
  // مسار الملف على القرص للملفات المرفوعة (خارج public — يُقدَّم عبر /api/files بتحقق صلاحيات)
  storagePath String?
  createdAt DateTime @default(now())
  userId    String
  yearId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  links     EvidenceLink[]

  @@index([userId, yearId])
}

// ─── ربط الشاهد بإنجاز أو هدف (إعادة استخدام بدون تكرار) ─────
model EvidenceLink {
  id            String      @id @default(cuid())
  attachmentId  String
  achievementId String?
  goalId        String?
  attachment    Attachment   @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  achievement   Achievement? @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  goal          Goal?        @relation(fields: [goalId], references: [id], onDelete: Cascade)

  // منع تكرار الرابط نفسه (الشاهد نفسه مع نفس الإنجاز/الهدف)
  @@unique([attachmentId, achievementId])
  @@unique([attachmentId, goalId])
  @@index([achievementId])
  @@index([goalId])
}

// ─── التأمل المهني ────────────────────────────────────────────
model Reflection {
  id       String   @id @default(cuid())
  term     String   @default("TERM1") // TERM1 | TERM2
  success  String? // أبرز نجاح
  practice String? // أكثر ممارسة مؤثرة
  develop  String? // مجال التطوير المرغوب
  nextTerm String? // ما سأفعله بشكل مختلف
  userId   String
  yearId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  year     AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([userId, yearId, term])
  @@index([userId, yearId])
}

// ─── الخطة التطويرية ──────────────────────────────────────────
model DevPlan {
  id        String   @id @default(cuid())
  goal      String // هدف تطويري
  action    String? // الإجراء
  period    String? // الفترة
  indicator String? // مؤشر النجاح
  result    String? // النتيجة
  userId    String
  yearId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, yearId])
}
