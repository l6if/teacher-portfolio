# Skills directory
/skills/
# ═══ بنية تحتية محلية — لا تدخل المستودع أبدًا ═══
# عنقود PostgreSQL المحلي (بيانات تشغيل حية)
.pg/
# حزم تنزيل ثنائيات PG
.pg-downloads/
# عملاء Prisma المولَّدون للأدوات
.pg-client/
.sqlite-client/
# ملف قاعدة SQLite + النسخ الاحتياطية (تبقى على القرص — ليست كودًا)
/db/*.db
/db/backups/
# تخزين الملفات المحلي (مرفوعات التطوير)
/storage/
# مخرجات المعاينة/التكافؤ
/download/
# ═══ سجلات وأدلة التشغيل الحساسة — خارج Git نهائيًا ═══
# سجل العمل متعدد الوكلاء (يحتوي بيانات تطوير حساسة — يبقى محليًا فقط)
worklog.md
# مخرجات أدوات القراءة المحفوظة (قد تحوي محتوى حساس من الجلسات)
tool-results/
# لقطات الإثبات التجريبية (أصول اختبار محلية) — تشمل مصادر بحث المؤشر الرسمي
screenshots/
# بنية الحاوية/البيئة المحلية (ليست جزءًا من التطبيق)
.zscripts/
tests/
Caddyfile
# ملفات pid وملفات نظام متفرقة
*.pid
nohup.out
agent-ctx/
.secret-patterns
supabase/
qa-state.json
